# Copy to .env and fill in what you need. Everything except PORT is optional.

PORT=3000
COMMUNITY_NAME=MuhallaReads
# Shared code neighbours must enter to join (web) or send as "join <code>" (WhatsApp). Empty = open.
JOIN_CODE=
# Added to 10-digit numbers typed without a country code.
DEFAULT_COUNTRY_CODE=91
# Where the SQLite database lives.
DATA_DIR=data
# Public https URL of this server (needed for Twilio signature checks).
PUBLIC_URL=

# --- Photo scanning (shelf / cover / barcode photos), powered by Claude ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Optional: higher Google Books quota for ISBN lookups ---
GOOGLE_BOOKS_API_KEY=

# --- WhatsApp option A: Meta WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
# The bot's own number (digits, with country code) - shown as a link in the web app.
WHATSAPP_DISPLAY_NUMBER=

# --- WhatsApp option B: Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

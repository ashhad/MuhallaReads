# Copy to .env and fill in what you need.
# The settings file doesn't support comments after a value on the same line.

PORT=3000
# The library's name, shown in the app and the bot.
COMMUNITY_NAME=MuhallaReads
# New people send "join <code>" to the bot before they can use the library. Empty = anyone can join.
JOIN_CODE=
# Admin WhatsApp numbers with country code, comma separated (for "stats", "members", "remove member").
ADMIN_PHONES=
# Where the SQLite database lives.
DATA_DIR=data
# Public https address of the web app, used in sign-in links the bot sends.
PUBLIC_URL=
TIME_ZONE=Asia/Kolkata

# --- Lending rules ---
LOAN_DAYS=21
MAX_PENDING_REQUESTS=5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
# The bot's own number (digits, with country code), used for the "Sign in with WhatsApp" button.
WHATSAPP_DISPLAY_NUMBER=
# Keep "off" until Meta approves the templates in docs/whatsapp-templates.md, then set "on".
WHATSAPP_TEMPLATES=off
WHATSAPP_TEMPLATE_LANG=en
# Paid template messages per month (about Rs 0.14 each in India). After this, notifications wait.
MONTHLY_TEMPLATE_LIMIT=200

# --- Photo scanning (shelf / cover / barcode photos), powered by Claude ---
ANTHROPIC_API_KEY=
# Haiku is about Rs 0.10 a photo. claude-sonnet-5-5 (~Rs 2) and claude-opus-5-5 (~Rs 4) read busy shelves better.
CLAUDE_MODEL=claude-haiku-5-5
# Hard limits: photos per member per 24 hours, photos per month for everyone, and a monthly spend cap in rupees.
PHOTO_DAILY_LIMIT=10
PHOTO_MONTHLY_LIMIT=300
PHOTO_MONTHLY_BUDGET_INR=90
# Anthropic bills in US dollars; this converts costs to rupees. Use ~105 to include 18% GST and card fees.
USD_INR_RATE=88

# --- Optional: higher Google Books quota for ISBN lookups ---
GOOGLE_BOOKS_API_KEY=

# --- Optional: security monitor (deploy/oracle/soc-setup.sh adds these on the server) ---
# Instant alerts on your phone (ntfy app): https://ntfy.sh/<a long random topic>. Or: sudo muhallareads-soc ntfy
SOC_NTFY_URL=
# A free healthchecks.io ping URL (period 10 minutes); it tells you if the server goes quiet.
# Or: sudo muhallareads-soc healthcheck
SOC_HEALTHCHECK_URL=
# Addresses that are never blocked, separated by spaces.
SOC_TRUSTED_IPS=

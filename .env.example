# Copy to .env and fill in what you need.
# The settings file doesn't support comments after a value on the same line.

PORT=3000
COMMUNITY_NAME=MuhallaReads
# Neighbours send "join <code>" to the bot before they can use the library. Empty = anyone can join.
JOIN_CODE=
# Admin WhatsApp numbers with country code, comma separated (for "stats", "members", "remove member").
ADMIN_PHONES=
# Where the SQLite database lives.
DATA_DIR=data
# Public https address of the web app, used in sign-in links the bot sends.
PUBLIC_URL=
TIME_ZONE=Asia/Kolkata

# --- Lending rules ---
LOAN_DAYS=21
MAX_PENDING_REQUESTS=5

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
# The bot's own number (digits, with country code), used for the "Sign in with WhatsApp" button.
WHATSAPP_DISPLAY_NUMBER=
# Keep "off" until Meta approves the templates in docs/whatsapp-templates.md, then set "on".
WHATSAPP_TEMPLATES=off
WHATSAPP_TEMPLATE_LANG=en
# Paid template messages per month (about Rs 0.14 each in India). After this, notifications wait.
MONTHLY_TEMPLATE_LIMIT=200

# --- Photo scanning (shelf / cover / barcode photos), powered by Claude ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Optional: higher Google Books quota for ISBN lookups ---
GOOGLE_BOOKS_API_KEY=
